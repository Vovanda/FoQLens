# environment
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# local Claude session state
.claude/session-context/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# raw run artifacts: activation and mask tensors are not committed,
# only the summaries (json/csv/png) next to them are
runs/**/raw/
*.pt
*.npy
*.npz
*.safetensors

# what an experiment stands on is kept, not left in a working tree: the oracles' fields over the groups are megabytes
# and they are the material its numbers were read from. A tree can be removed and take everything ignored with it -
# that is how the fields of E005 were lost on 21.09. The masks over the blocks stay out, they are tens of megabytes
# each; what a reader needs of them is the manifest beside them.
!runs/oracles/**/unified-fields-*.npz
!runs/oracles/**/precision-fields-*.npz
!runs/oracles/**/group-oracle-*.npz
!runs/E0*/**/precision-fields-*.npz
!runs/E0*/**/group-oracle-*.npz

# model cache, if HF_HOME points inside the repo
hf-cache/
# cut models (scripts/cut_model.py), if FOQLENS_HOME points inside the repo
*.refocustensors

# nvcc output, rebuilt from the .cu next to it
*.ptx

# browser artefacts from smoke runs
.playwright-mcp/
.idea/
